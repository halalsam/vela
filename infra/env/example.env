LOG_LEVEL=info
CORS_ORIGINS=https://vela.example,https://staging.vela.example
ENCRYPTION_KEY=
SENTRY_DSN=
BETTER_AUTH_SECRET=
API_PUBLIC_URL=https://staging-api.example.com
COOKIE_DOMAIN=example.com
SMS_ROUTE=console
APPLE_SERVICE_ID=
APPLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_USAGE_SPEED=1
PUSH_ROUTE=console
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_ENV=sandbox
FCM_SERVICE_ACCOUNT=
SELLER_NAME=vela
SELLER_GSTIN=
SELLER_ADDRESS=
SELLER_STATE=
INVOICE_PREFIX=VL
INVOICE_SAC=9984
ESIM_PROVIDER=mock
ESIM_ACCESS_CODE=
ESIM_BACKUP_PROVIDER=none
ESIM_GO_API_KEY=

# Backups: nightly encrypted dump (age public key) to an S3-compatible bucket
BACKUP_AGE_RECIPIENT=
BACKUP_S3_BUCKET=
BACKUP_HOUR_UTC=21
BACKUP_RETENTION_DAYS=30
RCLONE_CONFIG_S3_TYPE=s3
RCLONE_CONFIG_S3_PROVIDER=Cloudflare
RCLONE_CONFIG_S3_ENDPOINT=
RCLONE_CONFIG_S3_ACCESS_KEY_ID=
RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=
EMAIL_ROUTE=console
RESEND_API_KEY=
EMAIL_FROM=
ESIM_ACCESS_WEBHOOK_TOKEN=
ESIM_ACCESS_WEBHOOK_IP_CHECK=false

# Image uploads from the admin. With a bucket and keys set, images go to S3 (AWS, Cloudflare R2, Backblaze B2 or
# MinIO); otherwise, or if S3 fails, they're saved on the server in the uploads volume and served by the API.
STORAGE_DRIVER=auto
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_MB=8
