{
  "name": "@vela/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/expo": "~1.7.27",
    "@hono/node-server": "~2.1.9",
    "@hono/zod-openapi": "^1.6.3",
    "@sentry/node": "~11.14.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "~1.7.27",
    "drizzle-orm": "~0.45.4",
    "hono": "^4.13.19",
    "pdfkit": "0.20.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@vela/api": "workspace:*",
    "@vela/utils": "workspace:*",
    "drizzle-kit": "~0.31.11",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^5.1.0"
  }
}
