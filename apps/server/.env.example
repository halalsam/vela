APP_ENV=local
PORT=8787
DATABASE_URL=postgres://vela:vela@localhost:5432/vela
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32
SENTRY_DSN=

BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
API_PUBLIC_URL=http://localhost:8787
SMS_ROUTE=console
APPLE_BUNDLE_ID=com.sammk21.vela
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=

PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

MOCK_USAGE_SPEED=1
PUSH_ROUTE=console
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_ENV=sandbox
FCM_SERVICE_ACCOUNT=

SELLER_NAME=vela
SELLER_GSTIN=
SELLER_ADDRESS=
SELLER_STATE=
INVOICE_PREFIX=VL
INVOICE_SAC=9984

ESIM_ACCESS_CODE=
MOCK_USAGE_SPEED=1
ESIM_BACKUP_PROVIDER=none
ESIM_GO_API_KEY=
EMAIL_ROUTE=console
RESEND_API_KEY=
EMAIL_FROM=
ESIM_ACCESS_WEBHOOK_TOKEN=
ESIM_ACCESS_WEBHOOK_IP_CHECK=false

# Image uploads from the admin. With a bucket and keys set, images go to S3 (AWS, Cloudflare R2, Backblaze B2 or
# MinIO); otherwise, or if S3 fails, they're saved on the server in the uploads volume and served by the API.
STORAGE_DRIVER=auto
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=8
