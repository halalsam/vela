{
  "name": "@vela/brand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web/index.tsx",
    "./native": "./src/native/index.tsx",
    "./logo/*": "./logo/*",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vela/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "*",
    "react-native-svg": "*"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "react-native-svg": "15.16.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  }
}
